# Python code for cleaning
import pandas as pd

# Load CSV file
df = pd.read_csv(r"D:\AKSHARA Desktop\Documents\python projects\ecommerce_sales_34500.csv")

# Show first 5 rows
print("First 5 Rows:")
print(df.head())

# Show dataset information
print("\nDataset Info:")
print(df.info())

# Check missing values
print("\nMissing Values:")
print(df.isnull().sum())

# Remove duplicate rows
df = df.drop_duplicates()

# Fill missing numeric values with median
numeric_cols = df.select_dtypes(include=['int64', 'float64']).columns

for col in numeric_cols:
    df[col] = df[col].fillna(df[col].median())

# Fill missing text values with mode
text_cols = df.select_dtypes(include=['object', 'string']).columns

for col in text_cols:
    df[col] = df[col].fillna(df[col].mode()[0])

# Remove rows with too many missing values (optional)
df = df.dropna(thresh=len(df.columns)//2)

# Convert column names to lowercase
df.columns = df.columns.str.lower()

# Remove extra spaces from text columns
for col in text_cols:
    df[col] = df[col].str.strip()

# Check final missing values
print("\nFinal Missing Values:")
print(df.isnull().sum())


print("\nData cleaning completed successfully!")

df.to_csv(r"D:\AKSHARA Desktop\Documents\python projects\cleaned_data.csv", index=False)
print("Cleaned file saved as cleaned_data.csv")

